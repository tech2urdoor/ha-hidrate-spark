<?xml version="1.0" encoding="utf-8"?>
<!-- Light colours. They come from the phone's own palette (the wallpaper colours on Android 12 and
     later), so the app matches the rest of the phone and costs nothing to theme. -->
<resources>
    <color name="screen">@android:color/system_neutral2_50</color>
    <color name="card">@android:color/system_neutral1_10</color>
    <color name="field">@android:color/system_neutral2_50</color>
    <color name="text">@android:color/system_neutral1_900</color>
    <color name="text_quiet">@android:color/system_neutral2_700</color>
    <color name="primary">@android:color/system_accent1_600</color>
    <color name="on_primary">@android:color/system_accent1_0</color>
    <color name="primary_soft">@android:color/system_accent1_100</color>
    <color name="on_primary_soft">@android:color/system_accent1_900</color>
    <color name="tonal">@android:color/system_accent2_100</color>
    <color name="on_tonal">@android:color/system_accent2_900</color>
    <color name="notice">@android:color/system_accent3_100</color>
    <color name="on_notice">@android:color/system_accent3_900</color>
</resources>
